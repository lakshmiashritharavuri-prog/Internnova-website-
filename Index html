<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>InternNova - Homepage Redesign</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',system-ui,Arial}
:root{--blue:#2563eb;--blue2:#60a5fa;--dark:#0b1020;--card:#111a33;--card2:#0e152e;--text:#94a3b8;--border:#1e2a4a}
html{scroll-behavior:smooth}
body{background:var(--dark);color:#fff;overflow-x:hidden}
nav{position:fixed;top:0;width:100%;z-index:100;background:rgba(11,16,32,0.8);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;gap:14px}
.burger{width:44px;height:44px;border-radius:12px;background:var(--card);border:1px solid var(--border);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;cursor:pointer;transition:0.2s}
.burger span{width:20px;height:2.5px;background:#fff;border-radius:10px;transition:0.3s}
.burger.active span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.burger.active span:nth-child(2){opacity:0}
.burger.active span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}
.logo{font-weight:900;font-size:21px;letter-spacing:-0.5px;flex:1} .logo span{color:var(--blue2)}
.nav-links{display:flex;gap:18px} .nav-links a{color:var(--text);text-decoration:none;font-size:13px;font-weight:600}
.nav-links a:hover{color:#fff}
.nav-right{display:flex;gap:8px;align-items:center}
.btn{border:none;border-radius:22px;padding:10px 18px;font-weight:700;cursor:pointer;font-size:13px;transition:0.2s}
.btn-blue{background:linear-gradient(90deg,var(--blue),var(--blue2));color:#fff;box-shadow:0 6px 20px rgba(37,99,235,0.35)}
.btn-blue:hover{transform:translateY(-1px)}
.btn-ghost{background:transparent;border:1px solid var(--border);color:#fff}
.icon-btn{width:40px;height:40px;border-radius:50%;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center}
.drawer{position:fixed;top:0;left:-100%;width:320px;max-width:85vw;height:100vh;background:#0e152e;border-right:1px solid var(--border);z-index:99;padding:80px 18px 20px;transition:0.38s;overflow-y:auto}
.drawer.open{left:0}
.drawer a{display:flex;align-items:center;gap:10px;padding:13px 14px;border-radius:14px;color:var(--text);text-decoration:none;font-size:14px;font-weight:600;margin-top:6px}
.drawer a:hover{background:var(--card);color:#fff;transform:translateX(4px)}
.drawer a.active{background:linear-gradient(90deg,var(--blue),var(--blue2));color:#fff}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(2px);z-index:98;display:none}
.overlay.show{display:block}
.hero{padding:115px 5% 60px;display:grid;grid-template-columns:1.1fr 0.9fr;gap:36px;align-items:center}
.hero h1{font-size:56px;line-height:0.95;letter-spacing:-2px} .grad{background:linear-gradient(90deg,var(--blue2),#a5b4fc);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{color:var(--text);margin-top:14px;font-size:15px;line-height:1.7;max-width:520px}
.stats-row{display:flex;gap:28px;margin-top:24px} .stats-row b{font-size:24px;display:block} .stats-row span{font-size:11px;color:var(--text);text-transform:uppercase;letter-spacing:0.6px}
.hero-card{background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 55%,#60a5fa 100%);border-radius:24px;padding:22px;position:relative;overflow:hidden;box-shadow:0 20px 40px rgba(37,99,235,0.25)}
.badge{background:rgba(255,255,255,0.15);backdrop-filter:blur(8px);padding:7px 14px;border-radius:20px;font-size:11px;font-weight:700;display:inline-block;border:1px solid rgba(255,255,255,0.15)}
.section{padding:70px 5%} .sec-title{font-size:36px;text-align:center;letter-spacing:-1px} .sec-sub{text-align:center;color:var(--text);font-size:14px;margin-top:10px;max-width:600px;margin:0 auto}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px}
.card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:20px;transition:0.3s}
.card:hover{transform:translateY(-6px);border-color:var(--blue2);box-shadow:0 12px 30px rgba(0,0,0,0.3)}
.icon{width:48px;height:48px;border-radius:14px;background:#1e293b;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:12px}
.why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:32px}
.testi{display:flex;gap:16px;overflow-x:auto;scrollbar-width:none;padding-bottom:10px;margin-top:28px}
.testi .card{min-width:300px}
.faq-item{border:1px solid var(--border);border-radius:14px;margin-top:12px;overflow:hidden;cursor:pointer}
.faq-q{padding:16px;display:flex;justify-content:space-between;font-weight:700;font-size:14px}
.faq-a{padding:0 16px 16px;color:var(--text);font-size:13px;line-height:1.6;display:none}
.faq-item.active .faq-a{display:block}
.cta{background:linear-gradient(105deg,#1e40af 0%,#2563eb 50%,#3b82f6 100%);border-radius:24px;padding:50px 30px;text-align:center}
footer{border-top:1px solid var(--border);padding:36px 5%;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:24px;color:var(--text);font-size:13px}
@media(max-width:980px){.nav-links{display:none}.hero{grid-template-columns:1fr}.hero h1{font-size:40px}.grid3,.why-grid,footer{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav>
<div class="burger" id="burger" onclick="toggleDrawer()"><span></span><span></span><span></span></div>
<div class="logo">🚀 Intern<span>Nova</span></div>
<div class="nav-links"><a href="#home">Home</a><a href="#about">About</a><a href="#programs">Programs</a><a href="#domains">Domains</a><a href="#why">Why Us</a><a href="#faq">FAQ</a></div>
